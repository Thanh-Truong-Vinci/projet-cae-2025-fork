@baseUrl = http://localhost:3000

### Create the default admin
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "nom": "Admin",
  "prenom": "User",
  "email": "admin@example.com",
  "password": "admin",
  "rue": "Admin Street",
  "numeroRue": "1",
  "codePostal": "1000",
  "commune": "Admin City",
  "pays": "Admin Country",
  "tel": "123456789"
}

### Create with invalid email
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "nom": "Invalid",
  "prenom": "Email",
  "email": "invalid-email",
  "password": "password",
  "rue": "Invalid Street",
  "numeroRue": "3",
  "codePostal": "3000",
  "commune": "Invalid City",
  "pays": "Invalid Country",
  "tel": "111111111"
}

### Create without 'nom' attribute
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "prenom": "User",
  "email": "user@example.com",
  "password": "password",
  "rue": "User Street",
  "numeroRue": "4",
  "codePostal": "4000",
  "commune": "User City",
  "pays": "User Country",
  "tel": "222222222"
}

