@baseUrl = http://localhost:3000

### Try to login an unknown user
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "unknown",
  "password": "admin"
}

### Create the default admin
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "nom": "Admin",
  "prenom": "User",
  "email": "admin@example.com",
  "password": "admin",
  "rue": "Admin Street",
  "numeroRue": "1",
  "codePostal": "1000",
  "commune": "Admin City",
  "pays": "Admin Country",
  "tel": "123456789"
}

### Login the default admin
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin"
}

### Create the manager user
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "nom": "Manager",
  "prenom": "User",
  "email": "manager@example.com",
  "password": "manager",
  "rue": "Manager Street",
  "numeroRue": "2",
  "codePostal": "2000",
  "commune": "Manager City",
  "pays": "Manager Country",
  "tel": "987654321"
}

### Login the manager user
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "manager@example.com",
  "password": "manager"
}