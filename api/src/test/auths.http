### Login unknown user
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "unknown@example.com",
  "password": "unknown"
}

### Login without email
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "password": "password"
}

### Login without password
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "user@example.com"
}

### Register a new manager
POST {{baseUrl}}/auths/registermanager
Content-Type: application/json
Authorization: {{adminToken}}

{
  "name": "Manager",
  "firstname": "Test",
  "email": "manager@example.com",
  "password": "manager123"
}

### Register another new manager
POST {{baseUrl}}/auths/registermanager
Content-Type: application/json

{
  "name": "Manageer",
  "firstname": "Test",
  "email": "managerr@example.com",
  "password": "manager123"
}

### Create a Producer
POST {{baseUrl}}/auths/registerproducer
Content-Type: application/json
Authorization: {{adminToken}}

{
  "name": "Producer",
  "firstname": "IDK",
  "company": "ALEDink",
  "email": "producer-test@example.com",
  "password": "prod",
  "street": "LaRue",
  "number": "1234",
  "box": "12",
  "postalCode": "1251",
  "city": "LaVille",
  "country": "LePays",
  "phoneNumber": "+324794586718"
}

### Get all products
GET {{baseUrl}}/products/

### Get product details
GET {{baseUrl}}/products/details/1

### Get all products in descending order
GET {{baseUrl}}/products/?order=desc

#### Create a pizza with the admin token and an image
#### Create a photo with the admin token
POST {{baseUrl}}/photo
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="product"
Content-Type: application/json

{
  "product":"Magic Green"
}
--boundary
Content-Disposition: form-data; name="image"; filename="unavailable-photographer-WY6OwvMJEn8-unsplash.png"
Content-Type: image/jpg

// The 'pizza.png' file will be uploaded
< ./unavailable-photographer-WY6OwvMJEn8-unsplash.jpg

--boundary--