### Get all photos (no trailing slash)
GET http://localhost:3000/photo
Accept: application/json

#### Create a photo with the admin token
POST http://localhost:3000/photo
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="photo"
Content-Type: application/json

{
  "product":"Miel pissenlit"
}
--boundary
Content-Disposition: form-data; name="image"; filename="miel.jpg"
Content-Type: image/jpg

< ./miel.png

--boundary--
