@baseUrl = http://localhost:3000
@volunteerToken = {{login_volunteer.response.body.token}}
@producerToken = {{login_producer.response.body.token}} 

### Login as a volunteer
# @name login_volunteer
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "volunteer@example.com",
  "password": "Azqwazqw1@"
}

### Login en tant que producteur
# @name login_producer
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email": "producer@example.com",
  "password": "Azqwazqw1@"
}

### Get all batches
GET {{baseUrl}}/batches
Content-Type: application/json

### Mark an approved batch as received (replace 3 with an APPROVED batch ID)
PATCH {{baseUrl}}/batches/9/receive
Content-Type: application/json
Authorization: {{volunteerToken}}

#### Create a pizza with the admin token and an image
#### Create a photo with the admin token
POST {{baseUrl}}/createbatch
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="product"
Content-Type: application/json

{
  "product":"Magic Green"
}
--boundary
Content-Disposition: form-data; name="image"; filename="unavailable-photographer-WY6OwvMJEn8-unsplash.png"
Content-Type: image/jpg

// The 'pizza.png' file will be uploaded
< ./unavailable-photographer-WY6OwvMJEn8-unsplash.jpg

--boundary--

### Créer un nouveau batch avec image
POST {{baseUrl}}/batches/createbatch
Content-Type: multipart/form-data; boundary=boundary
Authorization: {{producerToken}}

--boundary
Content-Disposition: form-data; name="batch"
Content-Type: application/json

{
  "email": "producer@example.com",
  "productName": "Fraises Bio",
  "productType": "Fruits",
  "productDescription": "Fraises cultivées en agriculture biologique, variété Mara des Bois",
  "availabilityDate": "2025-05-15",
  "unitPrice": 4.50,
  "saleUnit": "barquette",
  "availableQuantity": 50
}
--boundary
Content-Disposition: form-data; name="image"; filename="fraises.jpg"
Content-Type: image/jpeg

< ./fraises.jpg
--boundary--